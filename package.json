{
  "name": "cradle",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "types": "wrangler types",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.cli.json",
    "test": "bun test",
    "cli:build": "bun build src/cli.ts --compile --outfile dist/cradle"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.16",
    "marked": "^18.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  },
  "cloudflare": {
    "bindings": {
      "TOKEN": {
        "description": "Your secret for the CLI, MCP and web view. Generate one with `openssl rand -hex 32` and **save it** in a password manager."
      }
    }
  },
  "bin": {
    "cradle": "src/cli.ts"
  }
}
